{
  "name": "apparatus-trial-harness",
  "version": "0.1.0",
  "private": true,
  "description": "CLI harness for a controlled A/B/C prompt experiment against the Anthropic Messages API — collects and archives runs, nothing else.",
  "type": "module",
  "scripts": {
    "harness": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt src tests",
    "fmt:check": "oxfmt --check src tests",
    "check": "npm run typecheck && npm run lint && npm run fmt:check && npm run test",
    "arm-c": "tsx src/build-arm-c.ts",
    "blind": "tsx src/blind-export.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
